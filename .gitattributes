# Normalize text sources across operating systems; leave binaries such as archives unchanged.
* text=auto
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.mjs text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.ps1 text eol=lf
*.txt text eol=lf
*.csv text eol=lf
*.zip binary
